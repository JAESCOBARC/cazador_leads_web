# SerpAPI - obtén tu key gratis en https://serpapi.com/ (100 búsquedas/mes gratis)
SERPAPI_KEY=tu_api_key_aqui

# Número máximo de leads por búsqueda (opcional, por defecto 10)
MAX_RESULTS=10

# Datos del remitente para los mensajes generados (opcional).
# Si se dejan vacíos, los mensajes usan placeholders [TU NOMBRE] etc.
REMITENTE_NOMBRE=
REMITENTE_CARGO=
AGENCIA_NOMBRE=
REMITENTE_CONTACTO=

# Base de datos (Postgres). Si se deja vacío usa SQLite local (solo desarrollo).
# En Render usa una base gratuita de Neon/Supabase y pega aquí su cadena de conexión.
DATABASE_URL=

# Clave para firmar las sesiones (cadena larga y aleatoria)
SECRET_KEY=

# Primer administrador (solo se usa si aún no hay usuarios).
# Si ADMIN_PASSWORD está vacío se genera una y se imprime en el log.
ADMIN_USER=admin
ADMIN_PASSWORD=
