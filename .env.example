# SerpAPI - obtén tu key gratis en https://serpapi.com/ (100 búsquedas/mes gratis)
SERPAPI_KEY=tu_api_key_aqui

# Máximo de leads NUEVOS por sector en cada exploración del radar (por defecto 20)
MAX_RESULTS=20

# Máximo de webs que se analizan por exploración (medición, móvil, SEO). Por defecto 40
MAX_SCAN_WEBS=40

# Páginas de Maps por consulta en la versión por consola (cazador_leads.py). Cada página = 1 crédito
MAPS_PAGINAS=1

# Cuota mensual de búsquedas de tu plan de SerpAPI (el plan gratis son 100). Si la API de cuenta responde,
# el panel usa el dato real; esta cifra es el respaldo y la referencia del medidor mensual.
SERPAPI_CUOTA_MES=100

# ---- Correo: avisos de cuota y envío manual de propuestas (guía: SETUP_CORREO.md) ----
# Elige UNA vía. A) Tu Gmail por SMTP, con "contraseña de aplicación" (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
# B) API de Resend (funciona en hostings que bloquean SMTP, como el plan gratis de Render)
RESEND_API_KEY=
# Quién recibe los avisos (varios separados por coma) y a qué porcentajes de la cuota se avisa
ALERTA_EMAIL_DESTINO=
ALERTA_UMBRALES=80
# Remitente visible para el cliente, dirección de respuestas (opcional) y tope diario de propuestas enviadas
EMAIL_REMITENTE=
EMAIL_RESPONDER_A=
ENVIO_MAX_DIA=5
# Enlace al panel dentro del aviso (en Render se toma de RENDER_EXTERNAL_URL)
APP_URL=

# Tope máximo de créditos de SerpAPI que se pueden gastar en un lote de búsqueda de redes (por defecto 50)
LOTE_MAX_CREDITOS=50

# Un caso de éxito REAL tuyo (una frase) para el mini-caso de los mensajes.
# Si lo dejas vacío, el mini-caso no aparece (nunca se inventa). Ej: "una clínica de Cali pasó de 4 a 15 citas por semana"
CASO_EXITO=

# Opcional: contacto que Nominatim pide en el User-Agent al geocodificar (déjalo vacío si no quieres incluirlo)
NOMINATIM_CONTACTO=

# Datos del remitente para los mensajes generados (opcional).
# Si se dejan vacíos, los mensajes usan placeholders [TU NOMBRE] etc.
REMITENTE_NOMBRE=
REMITENTE_CARGO=
AGENCIA_NOMBRE=
REMITENTE_CONTACTO=

# Base de datos (Postgres). Si se deja vacío usa SQLite local (solo desarrollo).
# En Render usa una base gratuita de Neon/Supabase y pega aquí su cadena de conexión.
DATABASE_URL=

# Clave para firmar las sesiones (cadena larga y aleatoria)
SECRET_KEY=

# Primer administrador (solo se usa si aún no hay usuarios).
# Si ADMIN_PASSWORD está vacío se genera una y se imprime en el log.
ADMIN_USER=admin
ADMIN_PASSWORD=
